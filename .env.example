# ── Core ─────────────────────────────────────────────────────────────
# SQLite for local development. For production switch prisma/schema.prisma
# provider to "postgresql" and point this at your Postgres/Supabase database.
DATABASE_URL="file:./dev.db"
# Public site URL (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial administrator created by `npm run db:seed`
ADMIN_EMAIL="admin@celestia.local"
ADMIN_PASSWORD="change-me-please"

# ── Email (optional) ────────────────────────────────────────────────
# Without SMTP settings, emails are stored in the dev outbox (Admin → Outbox)
# and printed to the server console. Nothing is actually sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CELESTIA <hello@example.com>"

# ── Payments (optional) ─────────────────────────────────────────────
# A provider only appears at checkout once its credentials are set here AND
# it is enabled in Admin → Settings. Merchant onboarding with each provider
# is required; integrations must be tested before going live.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
UZUM_MERCHANT_ID=""
UZUM_SECRET_KEY=""
