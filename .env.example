# ── Core ─────────────────────────────────────────────────────────────
# PostgreSQL connection. On Vercel these are filled in automatically when you
# connect a Neon database (Storage tab). Locally, point both at your database —
# e.g. copy them from Vercel with `npx vercel env pull .env`.
DATABASE_URL="postgresql://celestia:celestia@localhost:5432/celestia"
DATABASE_URL_UNPOOLED="postgresql://celestia:celestia@localhost:5432/celestia"
# Public site URL (canonical URLs, sitemap, emails). Optional on Vercel — the
# production *.vercel.app address is used automatically. Set it once you add a domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob token for admin photo uploads. Set automatically on Vercel when a Blob
# store is connected. Leave empty locally to save uploads to public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Initial administrator created by `npm run db:seed`
ADMIN_EMAIL="admin@celestia.local"
ADMIN_PASSWORD="change-me-please"

# ── Email (optional) ────────────────────────────────────────────────
# Without SMTP settings, emails are stored in the dev outbox (Admin → Outbox)
# and printed to the server console. Nothing is actually sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CELESTIA <hello@example.com>"

# ── Payments (optional) ─────────────────────────────────────────────
# A provider only appears at checkout once its credentials are set here AND
# it is enabled in Admin → Settings. Merchant onboarding with each provider
# is required; integrations must be tested before going live.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
UZUM_MERCHANT_ID=""
UZUM_SECRET_KEY=""
